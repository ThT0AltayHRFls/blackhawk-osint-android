<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>BlackHawk OSINT</ApplicationTitle>
    <ApplicationId>com.blackhawk.osint</ApplicationId>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" />
  </ItemGroup>

  <!-- The archive contains an older Xamarin.Forms-style source tree with many
       placeholder files and no matching XAML. Keep it in the repository while
       compiling the verified MAUI entry point below. -->
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="AppShell.xaml.cs" />
    <Compile Include="MauiProgram.cs" />
    <Compile Include="Platforms/Android/AndroidNotificationChannels.cs" />
    <Compile Include="Platforms/Android/MainActivity.cs" />
    <Compile Include="Views/Pages/MainPage.xaml.cs" />
    <MauiXaml Remove="**/*.xaml" />
    <MauiXaml Include="App.xaml" />
    <MauiXaml Include="AppShell.xaml" />
    <MauiXaml Include="Views/Pages/MainPage.xaml" />
  </ItemGroup>
</Project>
