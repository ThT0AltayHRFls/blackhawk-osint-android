<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label" x:Key="LargeLabel">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="TextColor" Value="#00D9FF"/>
    </Style>

    <Style TargetType="Label" x:Key="MidiumLabel">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextColor" Value="White"/>
    </Style>

    <Style TargetType="Button" x:Key="MauiButtonStyle">
        <Setter Property="BackgroundColor" Value="#00D9FF"/>
        <Setter Property="TextColor" Value="#0A0E27"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

</ResourceDictionary>
